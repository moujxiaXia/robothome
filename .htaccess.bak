# 机器人之家 - Apache 配置
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # 若部署在子目录，改为 RewriteBase /robothome/

    # 禁止访问敏感目录与文件
    RewriteRule ^(config|includes|sql|\.git)/ - [F,L]
    RewriteRule \.sql$ - [F,L]
    RewriteRule ^\.htaccess$ - [F,L]

    # 若请求的是真实存在的文件或目录，直接返回
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # 将根路径与友好 URL 导向 index.php（可选，当前站使用 ?page= 即可）
    # RewriteRule ^([a-z]+)/?$ index.php?page=$1 [L,QSA]
</IfModule>

# 安全：禁止目录列表
Options -Indexes

# 上传目录禁止执行 PHP
<Directory "uploads">
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</Directory>

# 字符集
AddDefaultCharset UTF-8
